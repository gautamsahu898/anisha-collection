# Start with: node --env-file=.env server.mjs
PORT=3000
NODE_ENV=development
# Optional initial administrator bootstrap. Leave blank to use the localhost first-run setup screen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Verified merchant UPI ID used to create dynamic amount-specific UPI collect links.
STORE_UPI_ID=
STORE_UPI_NAME=Anisha Collection
# Admin password-reset email (Gmail app password; do not use your regular Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
# Configure these only in your deployment provider's secret manager.
DATABASE_URL=
AUTH_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production deployment: set DATA_DIR to a persistent mounted folder.
DATA_DIR=
# Enable remote OTP reset only after SMTP is configured and HTTPS is enabled.
ALLOW_REMOTE_ADMIN_RESET=false
